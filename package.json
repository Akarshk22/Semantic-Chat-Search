{
  "name": "semantic-chat-search",
  "version": "1.0.0",
  "description": "Semantic Chat Archive Search: Hybrid vector and lexical retrieval in pure JavaScript (Node.js & React)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "server": "node server/src/server.js",
    "client": "npm --prefix client run dev",
    "generate-data": "node scripts/generateData.js",
    "build-index": "node scripts/buildIndex.js",
    "validate": "node scripts/validate.js",
    "evaluate": "node evaluate.js",
    "test": "npm run validate && npm run evaluate",
    "build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "keywords": [
    "semantic-search",
    "vector-search",
    "bm25",
    "embeddings",
    "natural-language-retrieval",
    "javascript",
    "node",
    "react"
  ],
  "author": "Akarsh Khare",
  "license": "MIT"
}
