# Server Configuration
PORT=8000
HOST=127.0.0.1

# Embedding Provider: local | openai | gemini | huggingface
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# API Key (only required if EMBEDDING_PROVIDER is openai/gemini/huggingface)
API_KEY=

# Retrieval Weights (must sum to 1.0)
WEIGHT_SEMANTIC=0.55
WEIGHT_LEXICAL=0.15
WEIGHT_PERSON=0.10
WEIGHT_TEMPORAL=0.10
WEIGHT_DECISION=0.10

# Context & Time
CONTEXT_WINDOW=3
REFERENCE_DATE=2026-09-12T00:00:00
