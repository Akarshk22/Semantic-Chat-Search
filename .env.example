# ── Embedding model ──────────────────────────────────────────────────────────
# Any sentence-transformers model that handles multilingual / Hinglish text.
# Recommended: paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── Paths ─────────────────────────────────────────────────────────────────────
DATA_DIR=data
INDEX_DIR=data/index

# ── Retrieval weights (must sum to 1.0) ───────────────────────────────────────
WEIGHT_SEMANTIC=0.55
WEIGHT_LEXICAL=0.15
WEIGHT_PERSON=0.10
WEIGHT_TEMPORAL=0.10
WEIGHT_DECISION=0.10

# ── Context expansion ─────────────────────────────────────────────────────────
# How many messages before/after the match to include in context window
CONTEXT_WINDOW=3

# ── Search ────────────────────────────────────────────────────────────────────
DEFAULT_TOP_K=5

# ── Reference date for relative time expressions ─────────────────────────────
# Leave empty to use today's date at runtime
REFERENCE_DATE=

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
